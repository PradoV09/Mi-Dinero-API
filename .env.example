# Entorno local (valores ficticios; NO usar en produccion).
# Copia este archivo a .env antes de levantar el entorno.

ENVIRONMENT=development

# PostgreSQL (Docker Compose)
POSTGRES_USER=mi_dinero
POSTGRES_PASSWORD=dev_only_password_change_me
POSTGRES_DB=mi_dinero
POSTGRES_TEST_DB=mi_dinero_test
POSTGRES_PORT=5433

# URLs de base de datos (driver async obligatorio)
DATABASE_URL=postgresql+asyncpg://mi_dinero:dev_only_password_change_me@127.0.0.1:5433/mi_dinero
TEST_DATABASE_URL=postgresql+asyncpg://mi_dinero:dev_only_password_change_me@127.0.0.1:5433/mi_dinero_test

# Claves (reemplazar en produccion por valores aleatorios reales)
SECRET_KEY=dev_only_secret_key_change_me
# Cifrado de campos (AES-256-GCM). Formato: v1:<clave base64url de 32 bytes>.
# Rotacion: v2:<nueva>,v1:<vieja> (la primera version es la actual).
FIELD_ENCRYPTION_KEY=v1:dev_only_field_encryption_key_change_me

# URLs publicas
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Correo. EMAIL_PROVIDER: "smtp" (Mailpit en desarrollo) o "resend" (produccion).
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Con EMAIL_PROVIDER=resend, esta variable es la RESEND_API_KEY.
EMAIL_PROVIDER_API_KEY=dev_only_email_provider_api_key
EMAIL_FROM=no-reply@midinero.test
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
SESSION_TTL_HOURS=720
RESEND_COOLDOWN_SECONDS=60

# Cookies (en produccion: COOKIE_SECURE=true y COOKIE_SAMESITE=none si web y API
# estan en dominios distintos).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
